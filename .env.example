# Copy to .env and adjust as needed/desired.

MMP_PORT=7979
POSTGRES_PORT=55432

# MMP_DEV_PASSWORD is shared by every account in development, so you can sign in as any of
# them to check what a role can do.
MMP_DEV_USER=admin
MMP_DEV_PASSWORD=changeme

POSTGRES_USER=mmp
POSTGRES_PASSWORD=mmp
POSTGRES_DB=mmp

RUST_LOG=info,mmp_server=debug,sqlx=warn

# Only needed if you are running the server directly on the host rather than inside a container.
# DATABASE_URL=postgres://mmp:mmp@localhost:55432/mmp
# MMP_WEB_DIST=web/dist
